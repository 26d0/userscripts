# Check that all userscripts have their install URLs in README.md
missing=()
while IFS= read -r -d '' file; do
  relative_path="${file#./}"
  raw_url="https://raw.githubusercontent.com/26d0/userscripts/main/${relative_path}"
  if ! grep -qF "$raw_url" README.md; then
    missing+=("$raw_url")
  fi
done < <(find src -name '*.user.js' -print0)

if [ ${#missing[@]} -gt 0 ]; then
  echo "ERROR: The following userscript install URLs are missing from README.md:"
  for url in "${missing[@]}"; do
    echo "  - $url"
  done
  exit 1
fi

# Check that staged userscripts have their @version updated if content changed
version_missing=()
for file in $(git diff --cached --name-only -- 'src/*.user.js'); do
  # Check if there are changes other than the @version line
  content_changed=$(git diff --cached -- "$file" | grep -E '^[+-]' | grep -v '^[+-]{3}' | grep -v '@version' | grep -v '^[+-][[:space:]]*$' | head -1)
  # Check if @version line was changed
  version_changed=$(git diff --cached -- "$file" | grep -E '^[+-].*@version')

  if [ -n "$content_changed" ] && [ -z "$version_changed" ]; then
    version_missing+=("$file")
  fi
done

if [ ${#version_missing[@]} -gt 0 ]; then
  echo "ERROR: The following userscripts have content changes but @version was not updated:"
  for file in "${version_missing[@]}"; do
    echo "  - $file"
  done
  exit 1
fi
